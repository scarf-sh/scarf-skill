{
  "version": "v1-draft",
  "policy": {
    "default": "deny",
    "allowMethods": ["GET"],
    "nonGetExceptions": [
      "createInsightsFilter",
      "updateInsightsFilter",
      "deleteInsightsFilter"
    ]
  },
  "capabilities": {
    "org_snapshot": [
      "getPackagesOverview",
      "getPixelsOverview",
      "exportCompanyRollup"
    ],
    "package_snapshot": [
      "getPackageByName",
      "getPackageById",
      "exportPackageEvents",
      "exportEntityAggregates"
    ],
    "top_referrers_and_acquisition": [
      "exportEntityPackageEvents",
      "exportEntityTrackingPixelEvents",
      "exportTrackingPixelEvents"
    ],
    "lead_and_funnel_summary": [
      "exportCompanyRollup",
      "exportCompanyPackageRollup",
      "exportCompanyPixelRollup",
      "exportEntityScarfScores"
    ],
    "export_helper": [
      "getScheduledExports",
      "getScheduledExportsHistory"
    ],
    "organization_download_feed_monitoring": [
      "getOrganizationDownloadFeed"
    ],
    "nl_qa_guardrails": [
      "getPackages",
      "getTrackingPixels",
      "getPackageByName",
      "getPackageById",
      "getTrackingPixel"
    ],
    "insights_filters_management": [
      "listInsightsFilters",
      "createInsightsFilter",
      "getInsightsFilter",
      "updateInsightsFilter",
      "deleteInsightsFilter"
    ]
  },
  "explicitAllowlist": [
    "listInsightsFilters",
    "createInsightsFilter",
    "getInsightsFilter",
    "updateInsightsFilter",
    "deleteInsightsFilter",
    "getPackages",
    "getPackagesOverview",
    "getPackageByName",
    "getPackageById",
    "exportEntityAggregates",
    "exportEntityPackageEvents",
    "exportPackageEvents",
    "getTrackingPixels",
    "getTrackingPixel",
    "getPixelsOverview",
    "exportEntityTrackingPixelEvents",
    "exportTrackingPixelEvents",
    "exportCompanyRollup",
    "exportCompanyPackageRollup",
    "exportCompanyPixelRollup",
    "exportEntityScarfScores",
    "getOrganizationDownloadFeed",
    "getScheduledExports",
    "getScheduledExportsHistory"
  ]
}
